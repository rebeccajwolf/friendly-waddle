version: 1.4

prefs:
  logPath: /dev/stdout
  errorLogPath: /dev/stderr

jobs:
  clean_memory:
    cmd: bash /home/user/app/clean_mem.sh
    time: "55 4,17 * * *"
    onError: Continue
    notifyOnError: false
    notifyOnFailure: false

  run_daily:
    cmd: TZ=America/New_York bash /home/user/app/src/run_daily.sh
    time: "0 5,18 * * *"
    onError: Continue
    notifyOnError: false
    notifyOnFailure: false